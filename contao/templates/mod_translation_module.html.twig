<!-- indexer::stop -->
{% add to head %}
    <link rel="stylesheet" href="{{ asset('bootstrap/dist/css/bootstrap.min.css', 'markocupic_contao_translation') }}">
    <link rel="stylesheet" href="{{ asset('css/styles.css', 'markocupic_contao_translation') }}">
    <script src="{{ asset('bootstrap/dist/js/bootstrap.min.js', 'markocupic_contao_translation') }}"></script>
    <script src="{{ asset('js/default.js', 'markocupic_contao_translation') }}"></script>
{% endadd %}

<div class="{{ class }} block"{{ cssID }}{% if style|default(null) %} style="{{ style }}"{% endif %}>
    <div class="trans-app-header">
        <div class="inner">
            {% if headline|default %}<h1 class="trans-header-headline">{{ headline }}</h1>{% endif %}
        </div>
    </div>


    <script>
        ContaoTranslator = {
            'authToken': '{{ auth_token }}',
        }
    </script>

    <div id="translationApp" class="trans-app">
        <div class="row">
            <aside class="col-12 col-sm-4 col-lg-3">
                <div class="inner">
                    {{ menu|raw }}
                </div>
            </aside>
            <main class="col-12 col-sm-8 col-lg-9">
                <div class="inner">
                    {{ messages|raw }}
                    {{ content|raw }}
                </div>
            </main>
        </div>
    </div>
</div>
<!-- indexer::continue -->
